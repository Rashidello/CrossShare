# ═══════════════════════════════════════
# CrossShare .gitignore
# ═══════════════════════════════════════

# ── Compiled binaries ──────────────────
*.exe
agent/agent
agent/agent-linux
agent/agent-linux-amd64
agent/agent-mac
agent/agent-mac-amd64
agent/agent-mac-arm64
agent/agent-windows.exe
server/server

# ── Prebuilt APKs ─────────────────────
crossshare.apk

# ── Cloudflare binary (55MB!) ─────────
server/cloudflared-windows-amd64.exe

# ── SQLite databases ──────────────────
*.db
*.db-wal
*.db-shm
server/data/

# ── Android build artifacts ───────────
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/captures/
android/*.iml
android/.externalNativeBuild/
android/.cxx/

# ── Go build cache ────────────────────
agent/vendor/
server/vendor/

# ── OS junk ───────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE files ─────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Log files ─────────────────────────
*.log

# ── Config with secrets ──────────────
.devdrop/
.crossshare/
