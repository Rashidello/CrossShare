<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_dialog_info"
        android:theme="@style/Theme.CrossShare"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DevicesActivity"
            android:exported="false" />

        <!-- Transparent foreground activity launched from the notification.
             Reading the clipboard MUST happen here (foreground context):
             Android 10+ blocks clipboard reads from background.
             taskAffinity="" + singleInstance keep it OUT of the app's task so
             tapping Send never brings the main window forward. -->
        <activity
            android:name=".SendClipboardActivity"
            android:exported="false"
            android:theme="@style/Theme.CrossShare.Invisible"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:documentLaunchMode="never"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <service
            android:name=".DevDropService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".SendTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_send"
            android:label="Send clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Handles the notification's inline "Type message" reply. -->
        <receiver
            android:name=".SendReplyReceiver"
            android:exported="false" />

    </application>
</manifest>
